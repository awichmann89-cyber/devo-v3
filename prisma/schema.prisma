// Devo - Veranstaltungstechnik Materialverwaltung
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

enum Role {
  ADMIN
  DISPONENT
  READER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          Role     @default(READER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdProjects Project[] @relation("ProjectCreator")
}

// ---------- Stammdaten ----------

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packUnits  PackUnit[]
}

model Category {
  id         String     @id @default(cuid())
  name       String     @unique
  prefix     String?    @unique // Kürzel für Inventarnummern (z.B. "MIK")
  parentId   String?
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryHierarchy")

  devices    Device[]
  packUnits  PackUnit[]

  @@index([parentId])
}

enum DeviceStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  DEFECT
  RETIRED
}

// Device = Typ. stockQuantity sagt, wie viele physisch im Lager sind.
// Pro Stück optional eine Seriennummer (siehe DeviceSerialNumber).
model Device {
  id               String       @id @default(cuid())
  name             String
  manufacturer     String?
  model            String?
  description      String?
  status           DeviceStatus @default(AVAILABLE)
  stockQuantity    Int          @default(1) // Anzahl physisch im Lager
  dailyRate        Decimal      @default(0) @db.Decimal(10, 2) // EUR pro Tag pro Stück
  replacementValue Decimal?     @db.Decimal(10, 2)
  weight           Decimal?     @db.Decimal(8, 2) // kg pro Stück
  powerWatts       Int?         // Stromaufnahme W pro Stück
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Optional: individuelle Seriennummern (max stockQuantity Stück)
  serialNumbers DeviceSerialNumber[]

  // Vorkommen in Packeinheiten
  packUnitItems PackUnitDevice[]

  @@index([status])
  @@index([categoryId])
}

// Individuelle Seriennummern pro Device-Typ
model DeviceSerialNumber {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  serialNumber String
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([deviceId, serialNumber])
  @@index([deviceId])
}

// Packeinheit (Case, Rack, Tasche, Trolley) — Typ mit Bestand.
model PackUnit {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique // z.B. PU-001
  description   String?
  weight        Decimal? @db.Decimal(8, 2) // Leergewicht des Cases
  stockQuantity Int      @default(1) // Anzahl identischer Cases im Lager
  isSingleItem  Boolean  @default(false) // 1:1-Container für einzelne Bookable-Items
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  items       PackUnitDevice[]
  assignments ProjectAssignment[]

  @@index([categoryId])
}

// Welche Devices sind in einer Packeinheit enthalten — mit Anzahl pro Case-Instanz.
model PackUnitDevice {
  id         String @id @default(cuid())
  packUnitId String
  packUnit   PackUnit @relation(fields: [packUnitId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1) // Wie viele dieser Devices PRO Case
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([packUnitId, deviceId])
  @@index([packUnitId])
  @@index([deviceId])
}

// ---------- Projekt ----------

enum ProjectStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model Customer {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects      Project[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description     String?
  status          ProjectStatus @default(DRAFT)

  // Planungszeitraum: blockt Material für andere Projekte
  planningStart   DateTime
  planningEnd     DateTime

  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdById     String?
  createdBy       User?         @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)

  assignments     ProjectAssignment[]
  // Berechnungszeiträume: Tage für die Mietkalkulation (mehrere möglich)
  billingPeriods  BillingPeriod[]
  // Freie Markdown-Notizen mit Titel
  projectNotes    ProjectNote[]
  // Personal- und Transport-Positionen
  services        ProjectService[]
  // Gruppen für Material und Personal & Transport (separat pro Tab via kind)
  groups          ProjectGroup[]

  @@index([status])
  @@index([customerId])
  @@index([planningStart, planningEnd])
}

// Gruppen-Typ: gehört zum Material- oder zum Personal/Transport-Tab.
// (Zwei separate Listen pro Projekt, damit z.B. "Ton" und "Aufbau" nicht vermischt werden.)
enum ProjectGroupKind {
  MATERIAL
  SERVICE
}

// Gruppen-Überschrift innerhalb eines Projekts.
// Jedes Assignment / jede Service-Position gehört zu genau einer Gruppe.
model ProjectGroup {
  id        String           @id @default(cuid())
  projectId String
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  kind      ProjectGroupKind
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  assignments ProjectAssignment[]
  services    ProjectService[]

  @@index([projectId, kind, sortOrder])
}

// Art einer Service-/Personalposition (rein zur Gruppierung)
enum ServiceItemKind {
  PERSONAL
  TRANSPORT
  SONSTIGES
}

// Abrechnungseinheit einer Position
enum BillingUnit {
  HOUR
  DAY
  FLAT
  PIECE
}

// Stammdaten-Eintrag im Katalog "Personal & Transport"
model ServiceItem {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  kind        ServiceItemKind @default(PERSONAL)
  unit        BillingUnit     @default(HOUR)
  unitPrice   Decimal         @default(0) @db.Decimal(10, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  projectServices ProjectService[]

  @@index([kind])
  @@index([active])
}

// Buchung einer Service-Position auf ein Projekt
model ProjectService {
  id                String  @id @default(cuid())
  projectId         String
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  serviceItemId     String
  serviceItem       ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)

  groupId           String
  group             ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  quantity          Decimal  @default(1) @db.Decimal(10, 2)
  unitPriceOverride Decimal? @db.Decimal(10, 2)
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([serviceItemId])
  @@index([groupId])
}

// Freie, mit Markdown formatierbare Notizen am Projekt (z.B. Anfahrt, Briefing).
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Einzelner Berechnungszeitraum innerhalb eines Projekts.
// Erlaubt z.B. zwei Veranstaltungs-Wochenenden ohne die Werktage dazwischen zu berechnen.
model BillingPeriod {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Buchung einer Packeinheit für ein Projekt.
model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  packUnitId String
  packUnit   PackUnit @relation(fields: [packUnitId], references: [id], onDelete: Cascade)

  groupId    String
  group      ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  quantity   Int      @default(1) // Anzahl dieser Packeinheit
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, packUnitId])
  @@index([packUnitId])
  @@index([projectId])
  @@index([groupId])
}
