// Cratel - Veranstaltungstechnik Materialverwaltung
// Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Direkter (un-pooler) Connect für Migrations — Pooler-URLs unterstützen
  // keine Advisory-Locks zuverlässig (siehe Vercel-Build-Error P1002).
  directUrl = env("DIRECT_URL")
}

// ---------- Auth ----------

enum Role {
  ADMIN
  DISPONENT
  READER
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  role          Role     @default(READER)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdProjects     Project[] @relation("ProjectCreator")
  maintainedProjects  Project[] @relation("ProjectMaintainer")
  uploadedFiles       ProjectFile[] @relation("ProjectFileUploader")
}

// ---------- Stammdaten ----------

model Location {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  packUnits  PackUnit[]
}

model Category {
  id         String     @id @default(cuid())
  name       String     @unique
  parentId   String?
  parent     Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[] @relation("CategoryHierarchy")

  devices    Device[]
  packUnits  PackUnit[]
  cables     Cable[]

  @@index([parentId])
}

// Device = Typ. stockQuantity sagt, wie viele physisch im Lager sind.
// Pro Stück optional eine Seriennummer (siehe DeviceSerialNumber).
model Device {
  id               String       @id @default(cuid())
  name             String
  manufacturer     String?
  model            String?
  description      String?
  stockQuantity    Int          @default(1) // Anzahl physisch im Lager
  dailyRate        Decimal      @default(0) @db.Decimal(10, 2) // EUR pro Tag pro Stück
  replacementValue Decimal?     @db.Decimal(10, 2)
  weight           Decimal?     @db.Decimal(8, 2) // kg pro Stück
  powerWatts       Int?         // Stromaufnahme W pro Stück
  inspectionExempt Boolean      @default(false) // Muss nicht geprüft werden (DGUV V3 nicht erforderlich)
  showOnDocuments  Boolean      @default(true)  // Auf Angeboten/Rechnungen anzeigen
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Optional: individuelle Seriennummern (max stockQuantity Stück)
  serialNumbers DeviceSerialNumber[]

  // Vorkommen in Packeinheiten
  packUnitItems PackUnitDevice[]

  // Projekt-Buchungen
  assignments  ProjectAssignment[]
  // Verpackungs-Scans (Public-Scan-Seite)
  packingScans PackingScan[]

  @@index([categoryId])
}

// Individuelle Seriennummern pro Device-Typ
model DeviceSerialNumber {
  id           String   @id @default(cuid())
  deviceId     String
  device       Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  serialNumber String
  barcode      String?  @unique // Optional: separater Barcode für DGUV V3 Scanner
  notes        String?
  createdAt    DateTime @default(now())

  inspections  Inspection[]
  packingScans PackingScan[]

  @@unique([deviceId, serialNumber])
  @@index([deviceId])
}

// Kabel-Typ (z.B. „DMX 5pol 10m", „Powercon TRUE1 5m"). Stockquantity = Anzahl physischer Stücke.
model Cable {
  id               String   @id @default(cuid())
  name             String
  description      String?
  cableType        String?  // z.B. "DMX", "Strom", "XLR"
  lengthMeters     Decimal? @db.Decimal(8, 2)
  connectorA       String?  // z.B. "XLR 5pol male"
  connectorB       String?  // z.B. "XLR 5pol female"
  stockQuantity    Int      @default(1)
  replacementValue Decimal? @db.Decimal(10, 2)
  weight           Decimal? @db.Decimal(8, 2)
  inspectionExempt Boolean  @default(false) // Muss nicht geprüft werden (DGUV V3 nicht erforderlich)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  units       CableUnit[]
  assignments ProjectCableAssignment[]
  packUnitItems PackUnitCable[]

  @@index([categoryId])
}

// Einzelne physische Kabel-Einheit (für DGUV V3 Prüfung). Barcode optional —
// wird beim Bulk-Anlegen leer gelassen und später pro Stück gepflegt.
model CableUnit {
  id        String   @id @default(cuid())
  cableId   String
  cable     Cable    @relation(fields: [cableId], references: [id], onDelete: Cascade)
  barcode   String?  @unique
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspections Inspection[]

  @@index([cableId])
}

enum InspectionResult {
  PASSED              // bestanden
  PASSED_CONDITIONAL  // bestanden mit Einschränkungen
  FAILED              // durchgefallen
}

// Prüfhistorie für DGUV V3 — gilt für DeviceSerialNumbers UND CableUnits.
// Jede Prüfung wird als eigener Datensatz gespeichert für volle Nachvollziehbarkeit.
model Inspection {
  id             String           @id @default(cuid())
  date           DateTime         @default(now())
  result         InspectionResult
  testerName     String?
  notes          String?
  // Genau eines der beiden ist gesetzt
  deviceSerialId String?
  deviceSerial   DeviceSerialNumber? @relation(fields: [deviceSerialId], references: [id], onDelete: Cascade)
  cableUnitId    String?
  cableUnit      CableUnit?       @relation(fields: [cableUnitId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())

  @@index([deviceSerialId])
  @@index([cableUnitId])
  @@index([date])
}

// Buchung eines Kabel-Typs für ein Projekt (analog zu ProjectAssignment für PackUnits).
model ProjectCableAssignment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  cableId   String
  cable     Cable    @relation(fields: [cableId], references: [id], onDelete: Cascade)

  groupId   String
  group     ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  quantity  Int      @default(1)
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, cableId])
  @@index([cableId])
  @@index([projectId])
  @@index([groupId])
}

// Packeinheit (Case, Rack, Tasche, Trolley) — Typ mit Bestand.
model PackUnit {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique // z.B. PU-001
  description   String?
  weight        Decimal? @db.Decimal(8, 2) // Leergewicht des Cases
  stockQuantity Int      @default(1) // Anzahl identischer Cases im Lager
  packMode      PackMode @default(FIXED) // FIXED = Case immer ganz, VARIABLE = Inhalt teilbar
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  items PackUnitDevice[]
  cableItems PackUnitCable[]
  packingScans PackingScan[]

  @@index([categoryId])
}

// Wie die Packeinheit auf der Packliste behandelt wird.
// FIXED    = Case wird IMMER komplett mitgenommen (z.B. Doppelcase Lautsprecher).
// VARIABLE = Inhalt kann einzeln entnommen werden (z.B. 6er-Set Bühnenpodest, kann auch nur 4 mitnehmen).
enum PackMode {
  FIXED
  VARIABLE
}

// Welche Devices sind in einer Packeinheit enthalten — mit Anzahl pro Case-Instanz.
model PackUnitDevice {
  id         String @id @default(cuid())
  packUnitId String
  packUnit   PackUnit @relation(fields: [packUnitId], references: [id], onDelete: Cascade)
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1) // Wie viele dieser Devices PRO Case
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([packUnitId, deviceId])
  @@index([packUnitId])
  @@index([deviceId])
}

// Welche Kabel sind in einer Packeinheit enthalten — analog zu PackUnitDevice.
// Werden auf der Packliste/PDF unter dem Case als 'Inhalt' mit ausgegeben.
model PackUnitCable {
  id         String @id @default(cuid())
  packUnitId String
  packUnit   PackUnit @relation(fields: [packUnitId], references: [id], onDelete: Cascade)
  cableId    String
  cable      Cable    @relation(fields: [cableId], references: [id], onDelete: Cascade)
  quantity   Int      @default(1) // Wie viele dieser Kabel PRO Case
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([packUnitId, cableId])
  @@index([packUnitId])
  @@index([cableId])
}

// ---------- Projekt ----------

enum ProjectStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

// Art des Projekts — entscheidet z.B. wie Rechnungen/Angebote ausgestellt werden:
// SPENDE       = Material wird kostenfrei zur Verfügung gestellt (gemeinnützig)
// DRYHIRE      = Reine Materialvermietung ohne Personal/Transport
// FULL_SERVICE = Material + Personal + Transport, schlüsselfertig
// VERKAUF      = Geräteverkauf statt Vermietung
enum ProjectKind {
  SPENDE
  DRYHIRE
  FULL_SERVICE
  VERKAUF
}

model Customer {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  email         String?
  phone         String?
  address       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  projects      Project[]
}

model Project {
  id              String        @id @default(cuid())
  name            String
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  description     String?
  status          ProjectStatus @default(DRAFT)
  kind            ProjectKind   @default(DRYHIRE)

  // Planungszeitraum: blockt Material für andere Projekte
  planningStart   DateTime
  planningEnd     DateTime

  discountPercent Decimal       @default(0) @db.Decimal(5, 2)
  // Rabatt auf den gesamten Material-Bereich (zusätzlich zu Gruppen-Rabatten)
  materialDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  // Rabatt auf den gesamten Personal-&-Transport-Bereich
  servicesDiscountPercent Decimal @default(0) @db.Decimal(5, 2)
  notes           String?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // Zeitpunkt des erstmaligen Übergangs in Status CONFIRMED — entscheidet bei
  // Material-Konflikten, welches Projekt die physische Reservierung gewinnt.
  confirmedAt     DateTime?

  createdById     String?
  createdBy       User?         @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // Verantwortlicher für das Projekt (kann unabhängig vom Ersteller sein)
  maintainerId    String?
  maintainer      User?         @relation("ProjectMaintainer", fields: [maintainerId], references: [id], onDelete: SetNull)

  assignments     ProjectAssignment[]
  cableAssignments ProjectCableAssignment[]
  adHocItems      ProjectAdHocItem[]
  // Berechnungszeiträume: Tage für die Mietkalkulation (mehrere möglich)
  billingPeriods  BillingPeriod[]
  // Freie Markdown-Notizen mit Titel
  projectNotes    ProjectNote[]
  // Personal- und Transport-Positionen
  services        ProjectService[]
  // Gruppen für Material und Personal & Transport (separat pro Tab via kind)
  groups          ProjectGroup[]
  // Erzeugte Rechnungen
  invoices        Invoice[]
  // Erzeugte Angebote
  quotes          Quote[]
  // Token für die Public-Scan-Seite (/scan/[token]) zum Abhaken beim Packen.
  // Lazy generiert, beim Klick auf "Token neu generieren" zurückgesetzt.
  packToken       String?       @unique
  packingScans    PackingScan[]
  // Frei hochgeladene Dateien (PDFs, Bilder, Office-Dokumente) zur Doku.
  files           ProjectFile[]

  @@index([status])
  @@index([customerId])
  @@index([planningStart, planningEnd])
}

// Gruppen-Typ: gehört zum Material- oder zum Personal/Transport-Tab.
// (Zwei separate Listen pro Projekt, damit z.B. "Ton" und "Aufbau" nicht vermischt werden.)
enum ProjectGroupKind {
  MATERIAL
  SERVICE
  CABLE
}

// Gruppen-Überschrift innerhalb eines Projekts.
// Jedes Assignment / jede Service-Position gehört zu genau einer Gruppe.
model ProjectGroup {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name            String
  kind            ProjectGroupKind
  sortOrder       Int              @default(0)
  // Rabatt-Prozent auf die Zwischensumme dieser Gruppe (zusätzlich zum projektweiten Rabatt)
  discountPercent Decimal          @default(0) @db.Decimal(5, 2)
  // Wenn false: Gruppe taucht nicht auf Rechnungen/Angeboten auf und fließt
  // nicht in Gesamtsummen ein. Z.B. interne Gruppe für nicht-berechnete Leihgaben.
  billable        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  assignments      ProjectAssignment[]
  services         ProjectService[]
  cableAssignments ProjectCableAssignment[]
  adHocItems       ProjectAdHocItem[]

  @@index([projectId, kind, sortOrder])
}

// Freie Position innerhalb eines Projekts — z.B. Weiterverkaufs-Geräte, die
// nicht im Stammdaten-Lager geführt werden. Hat einen festen Stückpreis und
// wird NICHT mit dem Miet-Tagesfaktor multipliziert.
model ProjectAdHocItem {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupId     String
  group       ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name        String      // z.B. „iPad Pro 12.9″"
  description String?     // Optionale Zusatzbeschreibung für die Rechnung
  quantity    Int         @default(1)
  // Stückpreis (Netto). Wird NICHT mit billingFactor multipliziert.
  unitPrice   Decimal     @db.Decimal(10, 2)
  sortOrder   Int         @default(0)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([projectId])
  @@index([groupId])
}

// Generisches Key-Value-Setting-Store (z.B. Rechnungsnummer-Prefix)
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Briefpapier-Vorlagen für Rechnungs-PDFs.
// FIRST_PAGE → Hintergrund für Seite 1 (mit Logo/Adresse/Header).
// FOLLOWING_PAGES → Hintergrund für alle weiteren Seiten.
enum LetterheadKind {
  FIRST_PAGE
  FOLLOWING_PAGES
}

model LetterheadTemplate {
  id        String         @id @default(cuid())
  kind      LetterheadKind @unique
  fileName  String
  mimeType  String
  data      Bytes
  updatedAt DateTime       @updatedAt
}

// Rechnung an einem Projekt — mit fortlaufender Nummer und Zahlungsfrist
enum InvoiceKind {
  INVOICE  // Reguläre Rechnung
  REMINDER // Mahnung zu einer bestehenden Rechnung
}

model Invoice {
  id        String      @id @default(cuid())
  number    String      @unique
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // Art des Dokuments — bestimmt Titel im PDF und UI
  kind      InvoiceKind @default(INVOICE)
  // Mahnstufe (1 = 1. Mahnung, 2 = 2., 3 = letzte). Bei kind=INVOICE immer 0.
  reminderLevel Int    @default(0)
  // Vorkasse-Flag: Wenn true, wird im PDF das „Rechnungsdatum"-Label durch
  // „Vorkasse zum" ersetzt. Beträge und Logik bleiben identisch.
  isPrepayment Boolean @default(false)
  // Bei kind=REMINDER: Verweis auf die ursprüngliche Rechnung
  relatedInvoiceId String?
  relatedInvoice   Invoice?  @relation("InvoiceReminders", fields: [relatedInvoiceId], references: [id], onDelete: Cascade)
  reminders        Invoice[] @relation("InvoiceReminders")
  date      DateTime @default(now())
  dueDate   DateTime
  // Snapshot der Beträge zum Zeitpunkt der Erstellung
  totalNet   Decimal  @db.Decimal(10, 2)
  // Brutto-Betrag (Netto + MwSt zum damaligen Steuersatz)
  totalGross Decimal? @db.Decimal(10, 2)
  // MwSt-Satz in Prozent zum Zeitpunkt der Erstellung
  vatPercent Decimal  @default(0) @db.Decimal(5, 2)
  // Zahlungseingang — null wenn noch nicht bezahlt
  paidAt    DateTime?
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([date])
  @@index([paidAt])
  @@index([relatedInvoiceId])
}

// Angebot an einem Projekt — eigenständige Nummer, Gültigkeit/Ablaufdatum statt Fälligkeit.
model Quote {
  id         String   @id @default(cuid())
  number     String   @unique
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  date       DateTime @default(now())
  expiresAt  DateTime
  totalNet   Decimal  @db.Decimal(10, 2)
  totalGross Decimal? @db.Decimal(10, 2)
  vatPercent Decimal  @default(0) @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  @@index([projectId])
  @@index([date])
  @@index([expiresAt])
}

// Art einer Service-/Personalposition (rein zur Gruppierung)
enum ServiceItemKind {
  PERSONAL
  TRANSPORT
  SONSTIGES
}

// Abrechnungseinheit einer Position
enum BillingUnit {
  HOUR
  DAY
  FLAT
  PIECE
}

// Stammdaten-Eintrag im Katalog "Personal & Transport"
model ServiceItem {
  id          String          @id @default(cuid())
  name        String          @unique
  description String?
  kind        ServiceItemKind @default(PERSONAL)
  unit        BillingUnit     @default(HOUR)
  unitPrice   Decimal         @default(0) @db.Decimal(10, 2)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  projectServices ProjectService[]

  @@index([kind])
  @@index([active])
}

// Buchung einer Service-Position auf ein Projekt
model ProjectService {
  id                String  @id @default(cuid())
  projectId         String
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  serviceItemId     String
  serviceItem       ServiceItem @relation(fields: [serviceItemId], references: [id], onDelete: Restrict)

  groupId           String
  group             ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  quantity          Decimal  @default(1) @db.Decimal(10, 2)
  unitPriceOverride Decimal? @db.Decimal(10, 2)
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([projectId])
  @@index([serviceItemId])
  @@index([groupId])
}

// Freie, mit Markdown formatierbare Notizen am Projekt (z.B. Anfahrt, Briefing).
model ProjectNote {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Einzelner Berechnungszeitraum innerhalb eines Projekts.
// Erlaubt z.B. zwei Veranstaltungs-Wochenenden ohne die Werktage dazwischen zu berechnen.
model BillingPeriod {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  start     DateTime
  end       DateTime
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

// Buchung eines Geräts für ein Projekt.
// Die Aggregation zu Packeinheiten passiert nur für die Packliste (siehe lib/packlist.ts).
model ProjectAssignment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  groupId    String
  group      ProjectGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  quantity   Int      @default(1)
  notes      String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([projectId, deviceId])
  @@index([deviceId])
  @@index([projectId])
  @@index([groupId])
}

// Einzelner Pack-Scan — wird beim Verpacken via /scan/[token] erzeugt.
// Pro gescannter Einheit eine Zeile. Auf der Packliste wird daraus der
// Soll/Ist-Vergleich gebildet (X von Y Stück gescannt).
model PackingScan {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Genau eines von beiden ist gesetzt:
  packUnitId  String?
  packUnit    PackUnit? @relation(fields: [packUnitId], references: [id], onDelete: Cascade)
  deviceId    String?
  device      Device?   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  // Wenn der Scan über eine konkrete Seriennummer aufgelöst wurde
  deviceSerialId String?
  deviceSerial   DeviceSerialNumber? @relation(fields: [deviceSerialId], references: [id], onDelete: SetNull)

  scannedCode String   // Der eingegebene rohe Code (für Nachvollziehbarkeit)
  scannedAt   DateTime @default(now())

  @@index([projectId])
  @@index([packUnitId])
  @@index([deviceId])
}

// Hochgeladene Dateien zu einem Projekt (PDFs, Bilder, Office-Dokumente etc.).
// Die eigentlichen Bytes liegen in Vercel Blob unter `blobPathname`;
// `blobUrl` ist der direkte Download-Link.
model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String   // Original-Dateiname inkl. Endung
  mimeType     String
  sizeBytes    Int

  blobUrl      String   // Public-Lese-URL aus @vercel/blob
  blobPathname String   // Pathname im Blob-Store, zum Löschen via del()

  uploadedById String?
  uploadedBy   User?    @relation("ProjectFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedAt   DateTime @default(now())

  @@index([projectId])
}
