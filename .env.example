# ---------------------------------------------------------------------------
# Datenbank
# ---------------------------------------------------------------------------
# Jede Instanz (= jedes Unternehmen) braucht eine EIGENE Datenbank — das Schema
# kennt keine Mandanten. Siehe DEPLOYMENT.md.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devo?schema=public"

# Direkter (un-pooler) Connect für Migrations — Pooler-URLs unterstützen keine
# Advisory-Locks zuverlässig (Vercel-Build-Error P1002). Lokal identisch mit
# DATABASE_URL, bei Neon/Supabase die "direct"/"non-pooling"-URL eintragen.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/devo?schema=public"

# ---------------------------------------------------------------------------
# NextAuth
# ---------------------------------------------------------------------------
# Pro Instanz einen EIGENEN Wert generieren: openssl rand -base64 32
# Gleiche Secrets über mehrere Instanzen hinweg = Session-Cookies sind
# instanzübergreifend gültig.
AUTH_SECRET="change-me-in-production"
AUTH_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Seed (siehe prisma/seed.ts)
# ---------------------------------------------------------------------------
# Initialer Admin. In Produktion PFLICHT — fehlt SEED_ADMIN_PASSWORD beim
# Anlegen, bricht der Seed (und damit der Build) bewusst ab.
SEED_ADMIN_EMAIL="admin@devo.local"
SEED_ADMIN_PASSWORD="admin123"

# Setzt das Passwort eines BESTEHENDEN Admins bei jedem Seed-Lauf zurück.
# Nur temporär setzen, wenn sich jemand ausgesperrt hat — sonst überschreibt
# jeder Deploy das vom Kunden gewählte Passwort.
SEED_ADMIN_FORCE_PASSWORD="false"

# Beispiel-Stammdaten anlegen (Demo-Disponent, Lagerorte, Kategorien,
# Positionen mit Beispielpreisen). Für lokale Entwicklung praktisch,
# für Kundeninstanzen: false.
SEED_DEMO_DATA="true"

# ---------------------------------------------------------------------------
# Datei-Uploads (Vercel Blob)
# ---------------------------------------------------------------------------
# Pro Instanz ein EIGENER Blob-Store, sonst liegen die Projektdateien
# verschiedener Unternehmen im selben Store. Wird von Vercel beim Verbinden
# eines Stores automatisch gesetzt; lokal aus dem Vercel-Dashboard kopieren.
BLOB_READ_WRITE_TOKEN=""

# ---------------------------------------------------------------------------
# E-Mail-Versand via Resend (https://resend.com)
# ---------------------------------------------------------------------------
# Bestätigungs-Mails bei Angebots-Annahme. Ohne API-Key wird der Versand
# übersprungen (nur Log). EMAIL_FROM muss eine in Resend verifizierte Domain
# sein — pro Kunde dessen eigene Absenderadresse.
RESEND_API_KEY=""
EMAIL_FROM="apps@alw-mediaworks.de"

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Schützt die Cron-Routen (/api/cron/*) — Vercel Cron sendet den Wert
# automatisch als "Authorization: Bearer <CRON_SECRET>" mit.
# Pro Instanz einen eigenen Wert.
CRON_SECRET=""
